[core]
	excludesFile = ~/.gitignore
    pager = bat --plain --paging=never
[init]
	defaultBranch = main

[includeIf "gitdir:~/work/Personal/"]
    path = ~/work/Personal/.gitconfig.personal

[includeIf "gitdir:~/work/Dfinity/"]
    path = ~/work/Dfinity/.gitconfig.dfinity

[includeIf "gitdir:~/work/Sotex/"]
    path = ~/work/Sotex/.gitconfig.sotex
[pager]
	diff = bat --plain --paging=never
	show = bat --plain --paging=never
[alias]
	diffall = !git diff HEAD | bat --plain --paging=never
